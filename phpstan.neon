includes:
  - phpstan-baseline.neon

parameters:
  # Keep PHPStan's incremental result cache inside the workspace so CI can persist it.
  tmpDir: .build/phpstan
  level: 5
  paths:
    - blocksy-child
  excludePaths:
    analyse:
      - blocksy-child/assets
      - blocksy-child/fonts
  scanFiles:
    - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
    - stubs/acf-stubs.php
    - stubs/theme-runtime-stubs.php
  treatPhpDocTypesAsCertain: false
  ignoreErrors:
    -
      message: "#^Unreachable statement \\- code above always terminates\\.$#"
      path: blocksy-child/inc/seo-cockpit/seo-cockpit-dashboard-v3.php
