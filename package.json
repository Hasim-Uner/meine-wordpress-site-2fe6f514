{
  "name": "meine-wordpress-site-tooling",
  "private": true,
  "description": "Build tooling for the Blocksy child theme deployment package.",
  "engines": {
    "node": ">=20 <23",
    "npm": ">=10 <11"
  },
  "scripts": {
    "test:forms": "playwright test --config scripts/tests/forms.config.cjs",
    "test:intake": "php scripts/tests/intake-endpoints.php",
    "build:theme": "bash scripts/build-theme-dist.sh",
    "lint:architecture": "bash scripts/validate-architecture.sh",
    "lint:canon": "bash scripts/canon-guard.sh",
    "lint:css-architecture": "python3 scripts/audit-css-architecture.py",
    "lint:legacy-css": "python3 scripts/audit-legacy-nx-css.py",
    "lint:php": "find blocksy-child -name '*.php' -print0 | xargs -0 -n1 php -l"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "lightningcss-cli": "1.32.0",
    "terser": "5.46.1"
  }
}
