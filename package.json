{
  "name": "meine-wordpress-site-tooling",
  "private": true,
  "description": "Build tooling for the Blocksy child theme deployment package.",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10 <11"
  },
  "scripts": {
    "check": "python3 scripts/check.py",
    "doctor": "python3 scripts/toolchain.py doctor",
    "setup": "python3 scripts/toolchain.py setup",
    "test:skills": "bash scripts/test-skills.sh",
    "lint:skills": "python3 scripts/validate-skills.py",
    "benchmark:agents": "python3 agents/skills/agent-system-maintenance/scripts/benchmark.py",
    "test:forms": "playwright test --config scripts/tests/forms.config.cjs",
    "test:intake": "php scripts/tests/intake-endpoints.php && php scripts/tests/solar-events.php && php scripts/tests/inquiry-events.php",
    "test:permalinks": "php scripts/tests/author-permalink-redirect.php",
    "test:provisioning": "php scripts/tests/page-provisioning.php && npm run test:retirement",
    "test:pricing": "php scripts/tests/tracking-ladder.php",
    "test:navigation": "php scripts/tests/navigation-contract.php",
    "test:navigation-ui": "playwright test --config scripts/tests/navigation.config.cjs",
    "build:theme": "bash scripts/build-theme-dist.sh",
    "lint:architecture": "bash scripts/validate-architecture.sh",
    "lint:canon": "bash scripts/canon-guard.sh",
    "lint:css-architecture": "python3 scripts/audit-css-architecture.py && python3 scripts/audit-css-values.py",
    "lint:legacy-css": "python3 scripts/audit-legacy-nx-css.py",
    "lint:php": "find blocksy-child -name '*.php' -print0 | xargs -0 -n1 php -l",
    "lint:route-architecture": "python3 scripts/validate-route-architecture.py",
    "test:retirement": "php scripts/tests/legacy-system-retirement.php && npm run test:glossary",
    "test:glossary": "php scripts/smoke-glossary.php && php scripts/tests/glossary-links.php"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "lightningcss-cli": "1.32.0",
    "terser": "5.46.1"
  }
}
