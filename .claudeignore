# Advisory only: Claude Code does not document .claudeignore. A hard exclusion
# needs a permissions.deny Read(...) rule in .claude/settings.json, which would
# also block intended opt-in reads. AGENTS.md "Context discipline" is the rule.

# Generated, dependency, and build artifacts
node_modules/**
vendor/**
.build/**
package-lock.json
composer.lock

# Heavy specialist references are opt-in
agents/skills/modern-web-guidance/guides/**

# Binary image assets: keep SVG source visible, ignore raster binaries
**/*.webp
**/*.avif
**/*.png
**/*.jpg
**/*.jpeg

# Human-facing changelogs and ephemeral memory
CHANGELOG.md
.ai/**

# Ephemeral or retired planning material
plans/**

# Historical audits and research notes
docs/audits/**
docs/references/**

# Large workflow exports are read only when n8n work is explicit
automations/n8n/workflows/*.json
